# ==========================================
# pdf_purifier - Beispielkonfiguration
# ==========================================
# Diese Datei nach ".env" kopieren und die Werte anpassen:
#   cp .env.example .env
# Die .env-Datei ist per .gitignore vom Git-Tracking ausgeschlossen.

# --- DeepSeek API ---
# WICHTIG: Das ist der API-Endpunkt, NICHT die Website!
# "https://deepseek.com" liefert HTTP 403 - die Umschreibung liefe dann ins Leere.
DEEPSEEK_API_KEY=sk-dein-echter-api-key-hier
DEEPSEEK_URL=https://api.deepseek.com/chat/completions
MODEL_NAME=deepseek-chat

# --- Dateien (relativ zur Projektwurzel) ---
INPUT_PDF=kauf_datei.pdf
OUTPUT_PDF=sauberes_buch.pdf
TEMP_MD=temp_extracted.md
TEMP_CLEAN_MD=temp_cleaned.md

# --- Verarbeitung ---
MAX_PARAGRAPHS_PER_CHUNK=8
MAX_CHARS_PER_CHUNK=4000
REQUEST_TIMEOUT=60
PDF_ENGINE=weasyprint

# --- Geschwindigkeit ---
# OCR=auto erkennt selbst, ob das PDF einen Textlayer hat (dann bleibt OCR aus).
# Gemessen: OCR auf einem Vektor-PDF kostet ~47 s und findet nichts.
# OCR=on erzwingt OCR (nötig bei eingescannten PDFs), OCR=off verbietet sie.
# IMAGE_SANITIZE: off | metadata | reencode
#   metadata = EXIF/XMP/ICC entfernen (verlustfrei)
#   reencode = zusätzlich JPEG neu kodieren (zerstört LSB-Steganografie,
#              kostet aber Bildqualität)
OCR=auto
IMAGES_SCALE=3.0
IMAGE_SANITIZE=metadata
MAX_WORKERS=4
# Seiten pro Block. Docling hält das ganze Dokument im RAM - bei 0 (aus) kann
# ein Buch mit 1400 Seiten mehrere GB belegen. 150 ist ein guter Kompromiss.
PAGES_PER_PART=150
# Wiederholungsversuche pro API-Anfrage (bei 429/5xx und Netzfehlern).
API_RETRIES=3
